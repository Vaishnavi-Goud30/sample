<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title> Portfolio</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, sans-serif;
      line-height: 1.6;
      color: #222;
      background: #f5f7fb;
    }

    /* Navbar */
    header {
      background: #111827;
      color: white;
      position: sticky;
      top: 0;
      z-index: 1000;
    }

    nav {
      max-width: 1100px;
      margin: auto;
      padding: 18px 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .logo {
      font-size: 24px;
      font-weight: bold;
      color: #38bdf8;
    }

    nav ul {
      display: flex;
      list-style: none;
      gap: 25px;
    }

    nav a {
      color: white;
      text-decoration: none;
      transition: 0.3s;
    }

    nav a:hover {
      color: #38bdf8;
    }

    /* Hero */
    .hero {
      min-height: 90vh;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 40px 20px;
      background: linear-gradient(135deg, #0f172a, #1e3a8a);
      color: white;
    }

    .hero h1 {
      font-size: clamp(40px, 7vw, 70px);
      margin-bottom: 10px;
    }

    .hero h1 span {
      color: #38bdf8;
    }

    .hero p {
      font-size: 20px;
      color: #dbeafe;
      margin-bottom: 30px;
    }

    .btn {
      display: inline-block;
      padding: 12px 25px;
      background: #38bdf8;
      color: #0f172a;
      text-decoration: none;
      border-radius: 8px;
      font-weight: bold;
      transition: 0.3s;
    }

    .btn:hover {
      background: white;
      transform: translateY(-2px);
    }

    /* Sections */
    section {
      max-width: 1100px;
      margin: auto;
      padding: 80px 20px;
    }

    .section-title {
      text-align: center;
      font-size: 35px;
      margin-bottom: 40px;
      color: #111827;
    }

    /* About */
    .about {
      text-align: center;
      max-width: 800px;
      margin: auto;
      font-size: 18px;
      color: #555;
    }

    /* Skills */
    .skills {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 20px;
    }

    .skill {
      background: white;
      padding: 25px;
      text-align: center;
      border-radius: 12px;
      box-shadow: 0 5px 20px rgba(0,0,0,0.08);
      font-weight: bold;
      transition: 0.3s;
    }

    .skill:hover {
      transform: translateY(-5px);
      color: #0284c7;
    }

    /* Projects */
    .projects {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 25px;
    }

    .project {
      background: white;
      border-radius: 12px;
      padding: 25px;
      box-shadow: 0 5px 20px rgba(0,0,0,0.08);
      transition: 0.3s;
    }

    .project:hover {
      transform: translateY(-5px);
    }

    .project h3 {
      margin-bottom: 10px;
      color: #1e3a8a;
    }

    .project p {
      color: #666;
      margin-bottom: 15px;
    }

    .project a {
      color: #0284c7;
      text-decoration: none;
      font-weight: bold;
    }

    /* Contact */
    .contact {
      text-align: center;
    }

    .contact p {
      margin: 10px 0;
      color: #555;
    }

    .contact a {
      color: #0284c7;
      text-decoration: none;
    }

    /* Footer */
    footer {
      text-align: center;
      background: #111827;
      color: #aaa;
      padding: 25px;
    }

    /* Mobile */
    @media (max-width: 600px) {
      nav {
        flex-direction: column;
        gap: 15px;
      }

      nav ul {
        gap: 15px;
        flex-wrap: wrap;
        justify-content: center;
      }

      .hero {
        min-height: 80vh;
      }

      section {
        padding: 60px 20px;
      }
    }
  </style>
</head>

<body>

  <!-- Navigation -->
  <header>
    <nav>
      <div class="logo">Portfolio</div>

      <ul>
        <li><a href="#home">Home</a></li>
        <li><a href="#about">About</a></li>
        <li><a href="#skills">Skills</a></li>
        <li><a href="#projects">Projects</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>
    </nav>
  </header>

  <!-- Home -->
  <section class="hero" id="home">
    <div>
      <h1>Hi, I'm <span>Your Name</span></h1>
      <p>Web Developer | Designer | Programmer</p>
      <a href="#projects" class="btn">View My Work</a>
    </div>
  </section>

  <!-- About -->
  <section id="about">
    <h2 class="section-title">About Me</h2>

    <div class="about">
      <p>
        I am a passionate web developer who enjoys creating modern,
        responsive and user-friendly websites. I love learning new
        technologies and turning ideas into real-world projects.
      </p>
    </div>
  </section>

  <!-- Skills -->
  <section id="skills">
    <h2 class="section-title">My Skills</h2>

    <div class="skills">
      <div class="skill">HTML5</div>
      <div class="skill">CSS3</div>
      <div class="skill">JavaScript</div>
      <div class="skill">Python</div>
      <div class="skill">Java</div>
      <div class="skill">Git & GitHub</div>
    </div>
  </section>

  <!-- Projects -->
  <section id="projects">
    <h2 class="section-title">My Projects</h2>

    <div class="projects">

      <div class="project">
        <h3>Portfolio Website</h3>
        <p>
          A responsive personal portfolio website built using HTML and CSS.
        </p>
        <a href="#">View Project →</a>
      </div>

      <div class="project">
        <h3>Weather App</h3>
        <p>
          A weather application that displays weather information
          using an API.
        </p>
        <a href="#">View Project →</a>
      </div>

      <div class="project">
        <h3>To-Do App</h3>
        <p>
          A simple task management application for organizing daily tasks.
        </p>
        <a href="#">View Project →</a>
      </div>

    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="contact">
    <h2 class="section-title">Contact Me</h2>

    <p>Email:
      <a href="mailto:your@email.com">your@email.com</a>
    </p>

    <p>GitHub:
      <a href="#">github.com/yourusername</a>
    </p>

    <p>LinkedIn:
      <a href="#">linkedin.com/in/yourusername</a>
    </p>
  </section>

  <!-- Footer -->
  <footer>
    <p>© 2026 Your Name. All Rights Reserved.</p>
  </footer>

</body>
</html>
