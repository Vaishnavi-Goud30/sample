<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Character Counter</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
      background: #f0f8ff;
    }
    .counter-container {
      background: #fff;
      padding: 30px;
      border-radius: 12px;
      box-shadow: 0 4px 10px rgba(0,0,0,0.2);
      text-align: center;
      width: 350px;
    }
    h2 {
      margin-bottom: 15px;
      color: #333;
    }
    textarea {
      width: 100%;
      height: 120px;
      padding: 10px;
      border-radius: 8px;
      border: 1px solid #ccc;
      font-size: 1rem;
      resize: none;
      outline: none;
    }
    .count-display {
      margin-top: 15px;
      font-size: 1.2rem;
      font-weight: bold;
      color: #4CAF50;
    }
    .warning {
      color: #f44336;
    }
  </style>
</head>
<body>
  <div class="counter-container">
    <h2>Friendly Character Counter ✨</h2>
    <textarea id="textInput" placeholder="Type something here..."></textarea>
    <div id="count" class="count-display">Characters: 0</div>
  </div>

  <script>
    const textInput = document.getElementById("textInput");
    const countDisplay = document.getElementById("count");

    textInput.addEventListener("input", () => {
      const length = textInput.value.length;
      countDisplay.textContent = `Characters: ${length}`;

      // Friendly feedback
      if (length > 100) {
        countDisplay.classList.add("warning");
        countDisplay.textContent += " ⚠️ Too long!";
      } else {
        countDisplay.classList.remove("warning");
      }
    });
  </script>
</body>
</html>
