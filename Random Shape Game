<!DOCTYPE html>
<html>
<head>
  <title>Select the Shape Game</title>
  <style>
    body { font-family: Arial, sans-serif; text-align: center; background: #f0f8ff; }
    h1 { color: #333; }
    .shapes { display: flex; justify-content: center; gap: 20px; margin-top: 20px; }
    .shape {
      width: 100px; height: 100px; cursor: pointer;
      display: flex; align-items: center; justify-content: center;
    }
    .circle { background: tomato; border-radius: 50%; }
    .square { background: gold; }
    .triangle {
      width: 0; height: 0;
      border-left: 50px solid transparent;
      border-right: 50px solid transparent;
      border-bottom: 100px solid lightgreen;
    }
    #message { margin-top: 20px; font-size: 1.2em; color: #444; }
    button { margin-top: 20px; padding: 10px 20px; font-size: 1em; cursor: pointer; }
  </style>
</head>
<body>

<h1 id="question">Select the Circle!</h1>
<div class="shapes">
  <div class="shape square" onclick="checkShape('square')"></div>
  <div class="shape circle" onclick="checkShape('circle')"></div>
  <div class="shape triangle" onclick="checkShape('triangle')"></div>
</div>
<p id="message"></p>
<button onclick="newRound()">Next Round</button>

<script>
  const shapes = ['circle', 'square', 'triangle'];
  let targetShape = 'circle';

  function newRound() {
    targetShape = shapes[Math.floor(Math.random() * shapes.length)];
    document.getElementById('question').textContent = `Select the ${targetShape.charAt(0).toUpperCase() + targetShape.slice(1)}!`;
    document.getElementById('message').textContent = '';
  }

  function checkShape(shape) {
    const message = document.getElementById('message');
    if (shape === targetShape) {
      message.textContent = "🎉 Correct! Well done!";
      message.style.color = "green";
    } else {
      message.textContent = "❌ Oops! Try again.";
      message.style.color = "red";
    }
  }

  // Start first round
  newRound();
</script>

</body>
</html>
