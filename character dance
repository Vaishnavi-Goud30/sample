<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Character Dance Show</title>
<style>
    body {
        background-color: #222;
        color: white;
        text-align: center;
        font-family: Arial, sans-serif;
        overflow: hidden;
    }
    #stage {
        position: relative;
        width: 100%;
        height: 400px;
        margin-top: 20px;
    }
    .sprite {
        position: absolute;
        bottom: 0;
        width: 100px;
        height: 150px;
        background-size: cover;
        animation: dance 1s infinite;
    }
    /* Dance animation keyframes */
    @keyframes dance {
        0%   { transform: translateY(0) rotate(0deg); }
        25%  { transform: translateY(-20px) rotate(-10deg); }
        50%  { transform: translateY(0) rotate(0deg); }
        75%  { transform: translateY(-20px) rotate(10deg); }
        100% { transform: translateY(0) rotate(0deg); }
    }
    /* Alternate animation for variety */
    @keyframes dance2 {
        0%   { transform: scale(1) rotate(0deg); }
        25%  { transform: scale(1.1) rotate(5deg); }
        50%  { transform: scale(1) rotate(0deg); }
        75%  { transform: scale(1.1) rotate(-5deg); }
        100% { transform: scale(1) rotate(0deg); }
    }
</style>
</head>
<body>

<h1>🎵 Character Dance Show 🎵</h1>
<button id="startBtn">Start Dance</button>
<div id="stage">
    <div class="sprite" id="sprite1" style="left: 20%; background-image: url('https://i.imgur.com/4AiXzf8.png');"></div>
    <div class="sprite" id="sprite2" style="left: 40%; background-image: url('https://i.imgur.com/4AiXzf8.png');"></div>
    <div class="sprite" id="sprite3" style="left: 60%; background-image: url('https://i.imgur.com/4AiXzf8.png');"></div>
</div>

<audio id="music" src="https://www.soundhelix.com/examples/mp3/SoundHelix-Song-1.mp3"></audio>

<script>
const music = document.getElementById('music');
const startBtn = document.getElementById('startBtn');
const sprites = document.querySelectorAll('.sprite');

startBtn.addEventListener('click', () => {
    music.play().catch(err => console.error("Audio play failed:", err));
    startDance();
});

function startDance() {
    let beat = 0;
    // Change dance style every beat
    setInterval(() => {
        beat++;
        sprites.forEach((sprite, index) => {
            if ((beat + index) % 2 === 0) {
                sprite.style.animation = 'dance 0.5s infinite';
            } else {
                sprite.style.animation = 'dance2 0.5s infinite';
            }
        });
    }, 500); // 500ms per beat
}
</script>

</body>
</html>
